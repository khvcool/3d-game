/* Корневой элемент на весь экран */
:root {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}

/* Окно паузы и настроек */
#MainPauseContainer, #SettingsContainer {
    width: 400px;
    height: auto;          
    max-height: 550px;     
    flex-grow: 0;          
    flex-shrink: 0;        
    align-self: center;    
    background-color: rgb(45, 45, 48);
    border-radius: 8px;
    padding: 20px;
    border-width: 1px;
    border-color: rgb(68, 68, 68);
    
    /* Делаем контейнер колонкой для прижатия кнопки вниз */
    flex-direction: column; 
}

/* Общие стили для кнопок */
Button {
    height: 45px;
    margin-bottom: 10px;
    font-size: 16px;
    border-radius: 4px;
}

/* Кнопка сохранения в настройках */
#SaveButton {
    background-color: rgb(40, 140, 40); /* Зеленый цвет успешного действия */
    color: rgb(255, 255, 255);
}

#SaveButton:hover {
    background-color: rgb(50, 170, 50);
}

/* Прижимаем кнопку "Назад" в самый низ контейнера настроек */
#BackButton {
    margin-top: auto;      /* Толкает кнопку вниз */
    margin-bottom: 0px;    /* Убираем нижний отступ */
}

/* Прижимаем кнопку выхода в самый низ меню паузы */
#QuitButton {
    margin-top: auto;      
    margin-bottom: 0px;    
    background-color: rgb(180, 40, 40); /* Красный цвет */
    color: rgb(255, 255, 255);          
}

#QuitButton:hover {
    background-color: rgb(220, 50, 50);
}

/* Подложка для затемнения фона при паузе (теперь тоже центрирует элементы) */
#BackgroundOverlay {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    
    /* Добавляем флекс-центровку внутрь оверлея */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* Прицел по центру */
#Crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    margin-top: -3px;
    background-color: rgba(255, 255, 255, 0.8);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.5);
}

/* Счетчик денег */
#MoneyLabel {
    position: absolute;
    left: 30px;
    top: 30px;
    font-size: 32px;
    color: rgb(50, 220, 80);
    -unity-font-style: bold;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
}